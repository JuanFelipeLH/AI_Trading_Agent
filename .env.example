# Credenciales de Binance (usa las de Testnet mientras USE_TESTNET=true)
API_KEY=your_binance_api_key
API_SECRET=your_binance_api_secret

# true  = usa Binance Spot Testnet (https://testnet.binance.vision)
# false = usa Binance real (producción)
USE_TESTNET=true

# paper_trading = simula las órdenes localmente (no envía órdenes reales, sí usa datos reales de mercado)
# live_trading  = envía órdenes reales al exchange configurado arriba (testnet o real, según USE_TESTNET)
TRADING_MODE=paper_trading

# Capital usado para calcular el tamaño de posición (position sizing)
INITIAL_CAPITAL=10000

LOG_LEVEL=INFO

# Solo necesaria si activas venice.enabled: true en strategy_config.yaml
VENICE_API_KEY=your_venice_api_key
